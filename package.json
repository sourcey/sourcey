{
  "name": "sourcey",
  "version": "3.9.1",
  "description": "Precision documentation from OpenAPI, MCP, Doxygen, godoc, rustdoc, and Markdown. Static HTML you own.",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "bin": {
    "sourcey": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./documents": {
      "types": "./dist/exports/document-index.d.ts",
      "import": "./dist/exports/document-index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "import": "./dist/astro/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/copy-theme-assets.mjs && cp src/client/*.js dist/client/ && cp src/core/diagram-worker.js dist/core/ && cp src/og/card-worker.js dist/og/ && cp -r src/og/fonts dist/og/ && node scripts/build-engine-assets.mjs && rm -rf dist/core/sourcey-godoc dist/core/godoc-introspect && mkdir -p dist/core/sourcey-godoc && cp -R go/sourcey-godoc/go.mod go/sourcey-godoc/doc.go go/sourcey-godoc/cmd dist/core/sourcey-godoc/ && rm -rf dist/core/sourcey-rustdoc && mkdir -p dist/core/sourcey-rustdoc && cp -R rust/sourcey-rustdoc/Cargo.toml rust/sourcey-rustdoc/Cargo.lock rust/sourcey-rustdoc/README.md rust/sourcey-rustdoc/src rust/sourcey-rustdoc/tests dist/core/sourcey-rustdoc/",
    "watch": "npm run build && tsc --watch --preserveWatchOutput",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:docs-mcp": "node scripts/test-docs-mcp.mjs",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js}\" \"test/**/*.{ts,tsx,js}\"",
    "godoc:go:test": "cd go/sourcey-godoc && go test ./...",
    "godoc:go:vet": "cd go/sourcey-godoc && go vet ./...",
    "godoc:packages:test": "packaging/sourcey-godoc/render-package-managers.test.sh",
    "cpp:release-gate": "node scripts/check-cpp-reference-quality.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.5",
    "@babel/parser": "8.0.8",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@sourcey/beautiful-mermaid": "1.1.5",
    "@swaggerexpert/jsonpath": "4.0.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "acorn": "8.19.0",
    "acorn-jsx": "5.3.2",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "diff": "9.0.0",
    "entities": "8.1.0",
    "github-slugger": "2.0.0",
    "heroicons": "^2.2.0",
    "htmlparser2": "12.0.0",
    "jiti": "^2.7.0",
    "js-yaml": "^5.5.0",
    "jsdom": "30.1.3",
    "marked": "^18.1.1",
    "mcp-parser": "^0.4.2",
    "mdast-util-mdx-jsx": "3.2.0",
    "mdast-util-mdxjs-esm": "2.0.1",
    "mermaid": "12.2.0",
    "micromark-extension-mdx-jsx": "3.0.2",
    "micromark-extension-mdxjs-esm": "3.0.0",
    "moxygen": "^2.2.2",
    "parse-srcset": "1.0.2",
    "preact": "^11.0.2",
    "preact-render-to-string": "^6.8.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "sanitize-html": "^2.18.1",
    "satori": "^0.63.2",
    "sharp": "0.35.5",
    "shiki": "^4.5.0",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.3.3",
    "unified": "11.0.5",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "astro": "7.4.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "lucide-static": "1.61.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "openapi",
    "swagger",
    "api",
    "documentation",
    "static-site-generator",
    "docs",
    "markdown",
    "api-docs",
    "developer-documentation",
    "doxygen",
    "godoc",
    "rustdoc",
    "golang",
    "rust",
    "go-docs",
    "go-documentation",
    "rust-docs",
    "mcp",
    "llms-txt",
    "static-docs"
  ],
  "funding": {
    "url": "https://sourcey.com"
  },
  "author": "Kam Low <oss@0state.com> (https://sourcey.com)",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourcey/sourcey.git"
  },
  "bugs": {
    "url": "https://github.com/sourcey/sourcey/issues"
  },
  "homepage": "https://sourcey.com",
  "overrides": {
    "fflate": "^0.7.5",
    "postcss-selector-parser": "^7.1.6"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "astro": ">=5.11.0 <8",
    "lucide-static": "1.61.0"
  },
  "peerDependenciesMeta": {
    "@fortawesome/fontawesome-free": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "lucide-static": {
      "optional": true
    }
  }
}
