{
  "name": "sourcey",
  "version": "3.6.12",
  "description": "Precision documentation from OpenAPI, MCP, Doxygen, godoc, rustdoc, and Markdown. Static HTML you own.",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "sourcey": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "import": "./dist/astro/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/copy-theme-assets.mjs && cp src/client/*.js dist/client/ && cp -r src/og/fonts dist/og/ && rm -rf dist/core/sourcey-godoc dist/core/godoc-introspect && mkdir -p dist/core/sourcey-godoc && cp -R go/sourcey-godoc/go.mod go/sourcey-godoc/doc.go go/sourcey-godoc/cmd dist/core/sourcey-godoc/ && rm -rf dist/core/sourcey-rustdoc && mkdir -p dist/core/sourcey-rustdoc && cp -R rust/sourcey-rustdoc/Cargo.toml rust/sourcey-rustdoc/Cargo.lock rust/sourcey-rustdoc/README.md rust/sourcey-rustdoc/src rust/sourcey-rustdoc/tests dist/core/sourcey-rustdoc/",
    "watch": "npm run build && tsc --watch --preserveWatchOutput",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "godoc:go:test": "cd go/sourcey-godoc && go test ./...",
    "godoc:go:vet": "cd go/sourcey-godoc && go vet ./...",
    "godoc:packages:test": "packaging/sourcey-godoc/render-package-managers.test.sh",
    "cpp:release-gate": "node scripts/check-cpp-reference-quality.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.3",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "heroicons": "^2.2.0",
    "jiti": "^2.7.0",
    "js-yaml": "^5.4.2",
    "marked": "^18.0.14",
    "mcp-parser": "^0.4.2",
    "moxygen": "^2.1.19",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "sanitize-html": "^2.17.7",
    "satori": "^0.33.5",
    "shiki": "^4.4.3",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "openapi",
    "swagger",
    "api",
    "documentation",
    "static-site-generator",
    "docs",
    "markdown",
    "api-docs",
    "developer-documentation",
    "doxygen",
    "godoc",
    "rustdoc",
    "golang",
    "rust",
    "go-docs",
    "go-documentation",
    "rust-docs",
    "mcp",
    "llms-txt",
    "static-docs"
  ],
  "funding": {
    "url": "https://sourcey.com"
  },
  "author": "Kam Low <oss@0state.com> (https://sourcey.com)",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourcey/sourcey.git"
  },
  "bugs": {
    "url": "https://github.com/sourcey/sourcey/issues"
  },
  "homepage": "https://sourcey.com",
  "overrides": {
    "fflate": "^0.7.5"
  }
}
